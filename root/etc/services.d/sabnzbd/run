#!/bin/sh
# SABnzbd s6 service

export HOME=/config

# First boot only: bind 0.0.0.0:8080 so the UI is reachable. SABnzbd
# persists these into sabnzbd.ini, which rules every boot after --
# passing --server unconditionally would override (and revert) any
# host/port the user sets in the ini or UI.
SERVER=""
[ -f /config/sabnzbd.ini ] || SERVER="--server 0.0.0.0:8080"

cd /app/sabnzbd
exec /usr/local/bin/s6-setuidgid bsd /usr/local/bin/python3 SABnzbd.py --config-file /config/sabnzbd.ini $SERVER
