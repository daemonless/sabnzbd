# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME=sabnzbd

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="SABnzbd" \
      org.opencontainers.image.description="Free and easy binary newsreader that automates the downloading and processing of Usenet content." \
      org.opencontainers.image.source="https://github.com/daemonless/sabnzbd" \
      org.opencontainers.image.url="https://sabnzbd.org/" \
      org.opencontainers.image.documentation="https://sabnzbd.org/wiki/" \
      org.opencontainers.image.licenses="GPL-2.0-or-later" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Downloaders" \
      io.daemonless.port="8080" \
      io.daemonless.volumes="/config,/downloads" \
      io.daemonless.pkg-name="${PKG_NAME}" \
      io.daemonless.arch="${FREEBSD_ARCH}"

# Install from FreeBSD packages
RUN pkg update && \
    pkg install -y ${PKG_NAME} python3 py312-pip && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# devel/py-rarfile is 4.1; SABnzbd 5.1.x needs 4.3 for rarfile.rar5_s2k.
# chmod: ocijail 0.6.0 leaks umask(077), so pip installs land unreadable by bsd.
RUN python3.12 -m pip install --break-system-packages --no-cache-dir 'rarfile>=4.3' && \
    chmod -R a+rX /usr/local/lib/python3.12/site-packages && \
    python3.12 -c "import rarfile; assert hasattr(rarfile, 'rar5_s2k'); print('rarfile', rarfile.__version__)" && \
    ! find /usr/local/lib/python3.12/site-packages -type f ! -perm -o+r | grep -q .

# Override package_info to show container update instructions
RUN SABNZBD_VERSION=$(pkg info ${PKG_NAME} | sed -n 's/.*Version.*: *//p') && \
    printf "UpdateMethod=docker\nPackageVersion=%s\nPackageAuthor=[daemonless](https://github.com/daemonless/daemonless)\n" "$SABNZBD_VERSION" > /usr/local/share/sabnzbd/package_info && \
    mkdir -p /app && echo "$SABNZBD_VERSION" > /app/version

# Create required directories
RUN mkdir -p /config /downloads/complete /downloads/incomplete

# Copy service definition
COPY root/ /

# Use pkg-specific run script
COPY root/etc/services.d/sabnzbd/run.pkg /etc/services.d/sabnzbd/run

# Make scripts executable
RUN chmod +x /etc/services.d/sabnzbd/run /etc/cont-init.d/* 2>/dev/null || true

# Set up s6 service link
RUN mkdir -p /run/s6/services/sabnzbd && \
    ln -sf /etc/services.d/sabnzbd/run /run/s6/services/sabnzbd/run

# --- Expose (Injected by Generator) ---
EXPOSE 8080

# --- Volumes (Injected by Generator) ---
VOLUME /config /downloads