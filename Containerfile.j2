ARG BASE_VERSION=15.1

# --- Build stage: build py-hachoir from our own ports overlay ---
# Not yet published to the FreeBSD pkg repos (daemonless/freebsd-ports devel/py-hachoir),
# so it's built from source here rather than pkg-installed.
FROM ghcr.io/daemonless/base:${BASE_VERSION} AS hachoir-builder
RUN pkg update && \
    pkg install -y FreeBSD-bmake FreeBSD-clibs-dev python3 py312-setuptools git && \
    fetch -qo /tmp/ports.tar.zst "https://download.freebsd.org/ports/ports/ports.tar.zst" && \
    mkdir -p /usr/ports/devel && \
    tar -xf /tmp/ports.tar.zst -C /usr/ports --strip-components=1 \
        ports/Mk ports/Templates ports/Keywords ports/lang/python312 && \
    rm /tmp/ports.tar.zst && \
    git clone --depth=1 https://github.com/daemonless/freebsd-ports.git /tmp/freebsd-ports && \
    cp -r /tmp/freebsd-ports/devel/py-hachoir /usr/ports/devel/ && \
    rm -rf /tmp/freebsd-ports
WORKDIR /usr/ports/devel/py-hachoir
RUN make BATCH=yes install clean
RUN mkdir -p /tmp/packages && pkg create -o /tmp/packages/ py312-hachoir

# --- Build stage: compile sabctools from source ---
# SABnzbd requires the exact sabctools version pinned in its release's
# requirements.txt -- anything newer and it boots with downloading
# disabled ("SABCTools disabled: no correct version found").
FROM ghcr.io/daemonless/base:${BASE_VERSION} AS builder
RUN pkg update && \
    pkg install -y FreeBSD-clang FreeBSD-clang-dev FreeBSD-clibs-dev python3 py312-pip py312-setuptools py312-wheel && \
    SABNZBD_VERSION=$(fetch -qo - "https://api.github.com/repos/sabnzbd/sabnzbd/releases/latest" | jq -r ".tag_name") && \
    SABCTOOLS_PIN=$(fetch -qo - "https://raw.githubusercontent.com/sabnzbd/sabnzbd/${SABNZBD_VERSION}/requirements.txt" | grep -i '^sabctools==') && \
    echo "Building ${SABCTOOLS_PIN} for SABnzbd ${SABNZBD_VERSION}" && \
    pip install --break-system-packages --target=/tmp/sabctools-build --no-cache-dir "${SABCTOOLS_PIN}" && \
    chmod -R a+rX /tmp/sabctools-build/sabctools* && \
    pkg remove -y FreeBSD-clang FreeBSD-clang-dev FreeBSD-clibs-dev py312-pip py312-setuptools py312-wheel && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# --- Final stage ---
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="python3 py312-pip py312-setuptools py312-wheel py312-sqlite3 py312-cryptography py312-feedparser py312-configobj py312-cherrypy py312-portend py312-chardet py312-pysocks py312-guessit py312-puremagic py312-rarfile py312-apprise par2cmdline-turbo unrar 7-zip ca_root_nss"
ARG UPSTREAM_URL="https://api.github.com/repos/sabnzbd/sabnzbd/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
{%- if ports %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:{{ ports[0].port }}/api?mode=version"
{%- else %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:8080/api?mode=version"
{%- endif %}

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.documentation="https://sabnzbd.org/wiki/" \
      org.opencontainers.image.licenses="GPL-2.0-or-later" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
{%- if mlock %}
      org.freebsd.jail.allow.mlock="required" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install dependencies
RUN pkg update && \
    pkg install -y \
    ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Copy compiled sabctools from builder
COPY --from=builder /tmp/sabctools-build/ /usr/local/lib/python3.12/site-packages/

# Install hachoir (devel/py-hachoir, not yet published to FreeBSD pkg repos)
COPY --from=hachoir-builder /tmp/packages/py312-hachoir-*.pkg /tmp/
RUN pkg add -f /tmp/py312-hachoir-*.pkg && \
    rm /tmp/py312-hachoir-*.pkg && \
    chmod -R a+rX /usr/local/lib/python3.12/site-packages/hachoir*

# py312-rarfile (pkg) is stuck at 4.1 -- SABnzbd needs rarfile>=4.3 (rar5_s2k).
RUN pip install --break-system-packages --no-cache-dir "rarfile==4.3" && \
    chmod -R a+rX /usr/local/lib/python3.12/site-packages/rarfile*

# Download and install SABnzbd from GitHub
RUN mkdir -p /app/sabnzbd && \
    chmod 755 /app && \
    SABNZBD_VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}") && \
    echo "Downloading SABnzbd ${SABNZBD_VERSION}" && \
    fetch -qo /tmp/sabnzbd.tar.gz "https://github.com/sabnzbd/sabnzbd/releases/download/${SABNZBD_VERSION}/SABnzbd-${SABNZBD_VERSION}-src.tar.gz" && \
    LANG=C.UTF-8 tar xzf /tmp/sabnzbd.tar.gz -C /app/sabnzbd --strip-components=1 && \
    test -f /app/sabnzbd/SABnzbd.py && \
    chmod -R o+rX /app/sabnzbd && \
    printf "UpdateMethod=docker\nPackageVersion=%s\nPackageAuthor=[daemonless](https://github.com/daemonless/daemonless)\n" "$SABNZBD_VERSION" > /app/sabnzbd/package_info && \
    echo "$SABNZBD_VERSION" > /app/version && \
    rm -f /tmp/sabnzbd.tar.gz

# Create directories
RUN mkdir -p /config /downloads/complete /downloads/incomplete && \
    chown -R bsd:bsd /app/sabnzbd /config /downloads

# Copy service definition and init scripts
COPY root/ /

# Make scripts executable
RUN chmod +x /etc/services.d/sabnzbd/run /etc/cont-init.d/* 2>/dev/null || true

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='port') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
